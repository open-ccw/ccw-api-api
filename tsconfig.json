{
  "compilerOptions": {
    "declaration": true,
    "rootDir": "./",
    "outDir": "dist",
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src", "./tsdown.config.ts"]
}
